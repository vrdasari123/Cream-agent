{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cream-agent.local/schemas/order-record-v1.json",
  "title": "Cream Agent order record v1",
  "description": "Structural schema. cream_agent.memory.orders enforces ticket conditions, history transitions, and the confirmation gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "created_at",
    "updated_at",
    "session",
    "journal",
    "ticket",
    "ticket_fingerprint",
    "state",
    "history"
  ],
  "properties": {
    "v": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[A-Z][A-Z0-9.-]{0,15}-(buy|sell)-\\d{3}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "session": {"type": "string", "minLength": 1},
    "journal": {"type": ["string", "null"]},
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "side", "order_type", "time_in_force"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,15}$"},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": ["string", "null"]},
        "notional": {"type": ["string", "null"]},
        "order_type": {"enum": ["market", "limit", "stop", "stop_limit"]},
        "limit_price": {"type": ["string", "null"]},
        "stop_price": {"type": ["string", "null"]},
        "time_in_force": {"type": "string", "minLength": 1}
      }
    },
    "ticket_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {
      "enum": [
        "draft",
        "confirmed",
        "submitted",
        "partially_filled",
        "filled",
        "canceled",
        "rejected",
        "abandoned"
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "from", "to", "session", "event_seq", "note"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "from": {"type": ["string", "null"]},
          "to": {"type": "string"},
          "session": {"type": "string", "minLength": 1},
          "event_seq": {"type": ["integer", "null"], "minimum": 1},
          "note": {"type": ["string", "null"]}
        }
      }
    }
  }
}
